# Copy to .env.cloud and fill in your keys — this file is gitignored.
#
# Usage:
#   cp .env.cloud.example .env.cloud
#   nano .env.cloud   # or any editor
#   bash go.sh

# ── Required ──────────────────────────────────────────────────────────────────
# Vast.ai API key — https://cloud.vast.ai/account/
VASTAI_API_KEY=your_vastai_api_key_here

# GitHub Personal Access Token with "repo" scope — https://github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here

# ── Optional overrides (uncomment to change) ──────────────────────────────────
# Target GPU model name (substring match against Vast.ai offers)
# VASTAI_GPU_NAME="RTX 4090"

# Maximum hourly price in USD
# VASTAI_MAX_PRICE="0.80"

# Minimum GPU VRAM in GB
# VASTAI_MIN_VRAM="24"

# Disk size to allocate on the instance (GB)
# VASTAI_DISK_GB="40"

# Docker image for the Vast.ai instance
# VASTAI_IMAGE="pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime"

# Training mode passed to gpu_training.yml workflow dispatch
# Options: micro | quick | full
# TRAINING_MODE="micro"

# SSH key used to connect to the Vast.ai instance
# SSH_KEY="$HOME/.ssh/id_vastai"

# Seconds to wait for the instance to boot before giving up
# BOOT_TIMEOUT="600"

# Seconds to wait for the training job to finish before giving up
# JOB_TIMEOUT="7200"

# ── Additional optional tokens ────────────────────────────────────────────────
# HuggingFace token for 5-10x faster dataset downloads (optional)
# HF_TOKEN=hf_xxxxxxxxxx

# ── Self-healing loop (go.sh) ────────────────────────────────────────────────
# Max number of GPU re-provisions in the self-healing loop
# MAX_GPU_RERUNS="5"

# Total wall-clock time limit for the entire loop (hours)
# MAX_TOTAL_HOURS="8"

# Seconds to wait before re-provisioning a new GPU after detecting a fix
# REPROVISION_COOLDOWN="60"

# Seconds between polls when waiting for Copilot to merge a fix
# FIX_POLL_INTERVAL="120"

# Max seconds to wait for a fix before giving up on this attempt
# FIX_POLL_TIMEOUT="3600"

# Max auto-fix iterations before go.sh stops (mirrors auto_fix_state.json max_iterations)
# MAX_AUTO_FIX_ITERATIONS="5"

# ── AI evaluation / auto-fix (optional) ──────────────────────────────────────
# Claude API key for AI diagnosis and auto-fix (preferred)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# Mistral API key (fallback when ANTHROPIC_API_KEY absent)
# MISTRAL_API_KEY=xxxxxxxxxx
